#!/bin/sh
# Quita cualquier atribución a asistentes de IA y rechaza mensajes vacíos.
msg="$1"
grep -viE '^[[:space:]]*(Co-Authored-By:|Claude-Session:)|Generated with \[Claude Code\]' "$msg" > "$msg.limpio"
mv "$msg.limpio" "$msg"
if ! grep -vE '^[[:space:]]*(#.*)?$' "$msg" | grep -q .; then
  echo "commit-msg: el mensaje quedó vacío." >&2
  exit 1
fi
