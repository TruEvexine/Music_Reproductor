# Copia este archivo a .env (ignorado por git) y rellena los dos valores.
# Son las ÚNICAS variables del cliente. Ambas son públicas por diseño.
#
# NUNCA pongas aquí (ni en Vercel con prefijo VITE_) una service_role key,
# una secret key (sb_secret_...), la contraseña de la base de datos ni una
# URI postgresql://. Todo lo que empieza por VITE_ acaba en el JavaScript
# que descarga cualquier visitante. El build falla si lo detecta.

# Dashboard de Supabase → Connect → Project URL
VITE_SUPABASE_URL=

# Dashboard de Supabase → Settings → API Keys → Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
